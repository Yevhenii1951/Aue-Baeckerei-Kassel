# Server-only. Never expose these values to the client.
NODE_ENV=development

# Canonical public site URL. Used for metadata, sitemap, robots and auth links.
# No trailing slash. Default fallback is http://localhost:3000.
URL=http://localhost:3000
# Brand name used in metadata and Open Graph.
SITE_NAME=Aue Bäckerei Kassel

# Supabase (required for /admin/login and the auth callback).
# Not needed until staff auth is wired up; the public site and the demo
# catalogue run without it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Add /auth/callback to the Supabase Auth redirect URL list
# for invite, magic-link and password-reset mails.

# Publicly exposed (client-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_DEMO=true

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development database, e.g. postgresql://<user>@localhost:5432/aue_beckerei
DATABASE_URL=
# Name of that database. The db:local:* scripts refuse to run against anything
# else, so migrations can never touch a hosted or production database.
DEV_DATABASE_NAME=aue_beckerei
# Separate database used by the integration tests. Tests DROP SCHEMA public
# between files, so it must never be a database you care about.
TEST_DATABASE_URL=
# Name of the test database, checked by the same fuse as above.
TEST_DATABASE_NAME=aue_beckerei_test
# One-off admin bootstrap (npm run db:bootstrap-admin), then remove from .env
BOOTSTRAP_ADMIN_AUTH_USER_ID=
BOOTSTRAP_ADMIN_DISPLAY_NAME=

# ---------------------------------------------------------------------------
# Optional feature groups
# ---------------------------------------------------------------------------
# Each group is off by default. When a flag is true, its keys become
# required and the group is validated via assertEnvGroup() in
# src/lib/env/groups.ts.
# No group has any call site in this base yet — the declarations are the
# contract a new project adopts when it adds that domain.

# ZAHLUNGEN — Stripe (enable when you add the payments domain)
ENABLE_PAYMENTS=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYPAL_ENABLED=false

# KI-ASSISTENT — Groq. A monthly budget is mandatory, not optional.
ENABLE_AI=false
AI_MONTHLY_BUDGET_EUR=
AI_PROVIDER_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# E-MAIL — Brevo transactional mail
ENABLE_EMAIL=false
BREVO_API_KEY=

# CRONJOBS — protects /api/cron/* routes with a bearer token
ENABLE_CRON=false
CRON_SECRET=
